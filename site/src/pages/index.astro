---
import DistrictShape from "../components/DistrictShape.astro";
import ScoreBadge from "../components/ScoreBadge.astro";
import UsMap from "../components/UsMap.astro";
import Base from "../layouts/Base.astro";
import { districts, getState, outline, rankedCount, states } from "../lib/data";
import { districtPath } from "../lib/districts";
import { type Card, sortCards } from "../lib/grid";

const cards = sortCards(
  districts.map(
    (d): Card => ({
      id: d.id,
      state: d.state,
      stateName: getState(d.state).name,
      number: d.number,
      score: d.irregularity,
      rank: d.rank_national,
    }),
  ),
  "irregular",
);
---

<Base title="Gerrymander Map" path="/" description="Every US congressional district, its shape, and how irregular that shape is compared with all the others.">
  <main>
    <h1>Gerrymander Map</h1>
    <p class="lede">
      Every US congressional district in the 2026 election, what it looks like, and how irregular
      its shape is compared with the other {rankedCount - 1} districts with lines.
    </p>
    <p class="note">
      A score describes shape, not intent. Coastlines, rivers and the Voting Rights Act can all
      make a district irregular for good reasons. <a href="/methodology">How scores work</a>
    </p>

    <UsMap />

    <form class="controls" role="search" aria-label="Find districts">
      <label>
        Search
        <input type="search" name="query" placeholder="TX-35, Texas or a ZIP code" autocomplete="off" />
      </label>
      <label>
        State
        <select name="state">
          <option value="">All states</option>
          {states.map((s) => <option value={s.state}>{s.name}</option>)}
        </select>
      </label>
      <label>
        Sort
        <select name="sort">
          <option value="irregular">Most irregular first</option>
          <option value="compact">Most compact first</option>
          <option value="state">State, A to Z</option>
        </select>
      </label>
      <label class="check">
        <input type="checkbox" name="atLarge" checked />
        Show at-large districts
      </label>
    </form>
    <p class="zip-message" aria-live="polite" data-zip-message hidden></p>
    <p class="count" aria-live="polite" data-count>Showing all {cards.length} districts.</p>

    <ul class="grid" data-grid>
      {
        cards.map((c) => (
          <li
            data-card
            data-id={c.id}
            data-state={c.state}
            data-state-name={c.stateName}
            data-number={c.number ?? ""}
            data-score={c.score ?? ""}
            data-rank={c.rank ?? ""}
          >
            <a href={districtPath(c.id)}>
              <div class="shape">
                <DistrictShape outline={outline(c.id, "card")} />
              </div>
              <span class="id">{c.id}</span>
              <span class="state-name">{c.stateName}</span>
              <ScoreBadge score={c.score} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty" data-empty hidden>No districts match. Try a state name or an ID like TX-35.</p>
  </main>
</Base>

<script>
  import { type Card, type Filters, type SortKey, matches, sortCards } from "../lib/grid";
  import { type ZipGroup, zipMessage, zipPrefix, zipQuery } from "../lib/zip-search";

  const form = document.querySelector<HTMLFormElement>("form.controls");
  const grid = document.querySelector<HTMLElement>("[data-grid]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const zipLine = document.querySelector<HTMLElement>("[data-zip-message]");
  // Each group of ZIP codes is fetched once, when a ZIP code in it is first searched for.
  const zipGroups = new Map<string, Promise<ZipGroup>>();
  let latest = 0;
  const items = [...document.querySelectorAll<HTMLElement>("[data-card]")];
  const toNumber = (value: string | undefined) => (value ? Number(value) : null);
  const cards = new Map<Card, HTMLElement>(
    items.map((el) => [
      {
        id: el.dataset["id"] ?? "",
        state: el.dataset["state"] ?? "",
        stateName: el.dataset["stateName"] ?? "",
        number: toNumber(el.dataset["number"]),
        score: toNumber(el.dataset["score"]),
        rank: toNumber(el.dataset["rank"]),
      },
      el,
    ]),
  );

  /**
   * Fetch a group of ZIP codes, once.
   * @param prefix The first three digits.
   * @returns The group, or an empty one when it can't be loaded.
   */
  function zipGroup(prefix: string): Promise<ZipGroup> {
    let group = zipGroups.get(prefix);
    if (!group) {
      group = fetch(`/zip/${prefix}.json`)
        .then((r) => (r.ok ? (r.json() as Promise<ZipGroup>) : {}))
        .catch(() => ({}));
      zipGroups.set(prefix, group);
    }
    return group;
  }

  async function update() {
    if (!form || !grid || !count || !empty || !zipLine) return;
    const run = ++latest;
    const data = new FormData(form);
    const filters: Filters = {
      query: String(data.get("query") ?? ""),
      state: String(data.get("state") ?? ""),
      includeAtLarge: data.get("atLarge") === "on",
    };
    const zip = zipQuery(filters.query);
    if (zip) {
      const districts = (await zipGroup(zipPrefix(zip)))[zip];
      if (run !== latest) return; // a newer search started while this one was loading
      filters.zipDistricts = districts?.map(([id]) => id) ?? [];
      zipLine.textContent = zipMessage(zip, districts);
    }
    zipLine.hidden = !zip;
    const sorted = sortCards([...cards.keys()], String(data.get("sort")) as SortKey);
    let shown = 0;
    for (const card of sorted) {
      const el = cards.get(card);
      if (!el) continue;
      const visible = matches(card, filters);
      el.hidden = !visible;
      shown += visible ? 1 : 0;
      grid.append(el);
    }
    count.textContent =
      shown === cards.size ? `Showing all ${shown} districts.` : `Showing ${shown} of ${cards.size} districts.`;
    empty.hidden = shown > 0 || Boolean(zip);
  }

  form?.addEventListener("input", () => void update());
  form?.addEventListener("submit", (event) => event.preventDefault());
</script>

<style>
  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
  }

  /* Grows with the screen: 1.25rem on phones, up to 1.5rem on wide screens. */
  .lede {
    max-width: 44rem;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.5rem);
    line-height: 1.45;
    color: var(--text-muted);
  }

  .note {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: end;
    margin-top: 1.5rem;
  }

  label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .check {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding-bottom: 0.4rem;
  }

  input[type="search"],
  select {
    min-width: 12rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .count,
  .empty {
    color: var(--text-muted);
  }

  /* What a ZIP code search found: the answer the visitor came for, so in the main text color. */
  .zip-message {
    max-width: 44rem;
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid a {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .grid a:hover,
  .grid a:focus-visible {
    border-color: var(--accent);
  }

  .shape {
    aspect-ratio: 1;
    padding: 0.5rem;
  }

  .id {
    font-weight: 700;
  }

  .state-name {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 40rem) {
    input[type="search"],
    select {
      min-width: 0;
      width: 100%;
    }

    .controls label:not(.check) {
      flex: 1 1 100%;
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
