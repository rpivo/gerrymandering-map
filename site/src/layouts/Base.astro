---
import "../styles/global.css";
import { ogImagePath, SITE_URL } from "../lib/og";

interface Props {
  title: string;
  description: string;
  /** The page's own path, such as `/tx/35`. Pages without one (the 404 page) share the site-wide preview image. */
  path?: string;
}

const { title, description, path } = Astro.props;
const image = `${SITE_URL}${ogImagePath(path ?? "/")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {path && <link rel="canonical" href={`${SITE_URL}${path}`} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gerrymandering Map" />
    {path && <meta property="og:url" content={`${SITE_URL}${path}`} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Gerrymandering Map</a>
      <nav aria-label="Main">
        <a href="/methodology">How scores work</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>
        Scores describe shape, not intent. <a href="/methodology">How scores work</a> ·{" "}
        <a href="https://github.com/rpivo/gerrymandering-map">Source on GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header,
  .site-footer {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem;
  }

  .site-header {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
  }

  .site-name {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
