---
import "../styles/global.css";
import { ogImagePath, SITE_URL } from "../lib/og";
import { applySavedTheme, setupThemeToggle } from "../lib/theme";

interface Props {
  title: string;
  description: string;
  /** The page's own path, such as `/tx/35`. Pages without one (the 404 page) share the site-wide preview image. */
  path?: string;
}

const { title, description, path } = Astro.props;
const image = `${SITE_URL}${ogImagePath(path ?? "/")}`;
// Written out as inline scripts: the first must run before the page draws (no light flash).
const savedTheme = `(${applySavedTheme.toString()})(document.documentElement, () => window.localStorage);`;
const themeToggle = `(${setupThemeToggle.toString()})(document.documentElement, document.querySelector(".theme-toggle"), () => window.localStorage);`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {path && <link rel="canonical" href={`${SITE_URL}${path}`} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gerrymander Map" />
    {path && <meta property="og:url" content={`${SITE_URL}${path}`} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={savedTheme} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-title">
        <a class="site-name" href="/">Gerrymander Map</a>
        <span class="site-domain">gerrymandermap.us</span>
      </div>
      <nav aria-label="Main">
        <a href="/methodology">How scores work</a>
      </nav>
      <button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label="Dark mode" hidden>
        <span class="knob"></span>
        <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
        </svg>
        <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z" />
        </svg>
      </button>
    </header>
    <slot />
    <footer class="site-footer">
      <p>
        Scores describe shape, not intent. <a href="/methodology">How scores work</a> ·{" "}
        <a href="https://github.com/rpivo/gerrymandering-map">Source on GitHub</a> ·{" "}
        Like this project? <a href="https://ko-fi.com/rpivovar"
          ><svg class="coffee" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM16 10.5h1.5a2.5 2.5 0 0 1 0 5H16M8 3.5v2.5M12 3.5v2.5" />
          </svg>Buy me a coffee!</a
        >
      </p>
    </footer>
    <script is:inline set:html={themeToggle} />
  </body>
</html>

<style>
  .site-header,
  .site-footer {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem;
  }

  /* One row: the name on the left, the link and the theme switch on the right. */
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: "name nav toggle";
    gap: 0.5rem 1rem;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }

  /* The name, with the site's address in small type beneath it. */
  .site-title {
    grid-area: name;
    display: flex;
    flex-direction: column;
  }

  .site-domain {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  nav {
    grid-area: nav;
    white-space: nowrap;
  }

  /* Phones have no room for one row (it needs about 410px), so the switch stays beside the
     name and the link moves to a line of its own below. */
  @media (max-width: 26rem) {
    .site-header {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "name toggle"
        "nav nav";
    }
  }

  /* A switch: a pill with a sun and a moon, and a knob that slides to the mode in use. */
  .theme-toggle {
    grid-area: toggle;
    --track-w: 3.5rem;
    --track-h: 1.9rem;
    --gap: 3px;
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    align-self: center;
    width: var(--track-w);
    height: var(--track-h);
    padding: 0 0.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .knob {
    position: absolute;
    top: var(--gap);
    left: var(--gap);
    width: calc(var(--track-h) - 2px - 2 * var(--gap));
    height: calc(var(--track-h) - 2px - 2 * var(--gap));
    background: var(--accent);
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  .theme-toggle[aria-checked="true"] .knob {
    transform: translateX(calc(var(--track-w) - var(--track-h)));
  }

  .icon {
    position: relative;
    width: 0.95rem;
    height: 0.95rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .sun {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .moon {
    fill: currentColor;
  }

  /* The icon under the knob is the mode in use. */
  .theme-toggle[aria-checked="false"] .sun,
  .theme-toggle[aria-checked="true"] .moon {
    color: var(--bg);
  }

  @media (prefers-reduced-motion: reduce) {
    .knob,
    .icon {
      transition: none;
    }
  }

  .site-name {
    white-space: nowrap;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  /* A coffee cup drawn in the link's color, sitting on the text's baseline. */
  .coffee {
    width: 1.1em;
    height: 1.1em;
    margin-right: 0.25em;
    vertical-align: -0.2em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
