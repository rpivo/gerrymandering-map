---
import { states } from "../lib/data";
import { STATE_TILES, TILE_COLUMNS, TILE_ROWS } from "../lib/state-tiles";

// Links stay in alphabetical order for keyboards and screen readers; CSS places each one.
const tiles = states.map((s) => {
  const [row, col] = STATE_TILES[s.state] ?? [0, 0];
  return { ...s, style: `grid-row: ${row + 1}; grid-column: ${col + 1}` };
});
const gridStyle = `grid-template-columns: repeat(${TILE_COLUMNS}, 1fr); grid-template-rows: repeat(${TILE_ROWS}, auto)`;
---

<nav class="state-tiles" aria-label="States">
  <h2>Go to a state</h2>
  <ul style={gridStyle}>
    {
      tiles.map((s) => (
        <li style={s.style}>
          <a href={`/${s.state.toLowerCase()}`} aria-label={s.name} title={s.name}>
            {s.state}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .state-tiles {
    margin: 1.5rem 0;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  ul {
    display: grid;
    gap: 3px;
    max-width: 30rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }
</style>
