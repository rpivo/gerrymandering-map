---
import type { Outline } from "../lib/data";

interface Props {
  outline: Outline;
  /** Omit inside a link that already names the district, so screen readers don't say it twice. */
  label?: string;
  class?: string;
}

const { outline, label, class: className } = Astro.props;
---

<svg
  class:list={["district-shape", className]}
  viewBox={outline.viewBox}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <path d={outline.d} fill-rule="evenodd"></path>
</svg>

<style>
  .district-shape {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  path {
    fill: var(--shape);
    stroke: var(--shape);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
</style>
