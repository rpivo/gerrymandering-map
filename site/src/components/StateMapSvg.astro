---
import { districtsInState, stateMap } from "../lib/data";
import { districtPath } from "../lib/districts";
import { scoreBand } from "../lib/format";

interface Props {
  state: string;
  stateName: string;
  highlight?: string;
}

const { state, stateName, highlight } = Astro.props;
const map = stateMap(state);
const rows = districtsInState(state).map((d) => ({
  district: d,
  path: map.paths[d.id] ?? "",
  band: d.irregularity === null ? "unranked" : `band-${scoreBand(d.irregularity).key}`,
  title: d.irregularity === null ? `${d.id}: at-large` : `${d.id}: irregularity ${d.irregularity}`,
}));
---

<svg
  class:list={["state-map", { "has-highlight": highlight }]}
  viewBox={map.viewBox}
  role="img"
  aria-label={highlight ? `${highlight} highlighted on a map of ${stateName}` : `Map of ${stateName}'s districts`}
>
  <defs>
    {rows.map(({ district, path }) => <path id={`shape-${district.id}`} d={path} fill-rule="evenodd" />)}
  </defs>
  {/* SVG has no z-index, so all fills go first and the links (which draw only the hover outline) on top. */}
  {
    rows.map(({ district, band }) => (
      <use href={`#shape-${district.id}`} class:list={["fill", band, { current: district.id === highlight }]} />
    ))
  }
  {
    rows.map(({ district, title }) => (
      <a href={districtPath(district.id)} tabindex="-1">
        <title>{title}</title>
        <use href={`#shape-${district.id}`} class="outline" />
      </a>
    ))
  }
</svg>
{map.note && <p class="map-note">{map.note}</p>}

<style>
  .map-note {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .state-map {
    display: block;
    width: 100%;
    max-height: 32rem;
  }

  .fill {
    fill: var(--band, var(--shape-muted));
    stroke: var(--bg);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .has-highlight .fill {
    fill: var(--shape-muted);
  }

  .has-highlight .fill.current {
    fill: var(--accent);
  }

  .outline {
    fill: none;
    stroke: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    pointer-events: fill;
  }

  a:hover .outline,
  a:focus-visible .outline {
    stroke: var(--text);
  }
</style>
