---
import { cityTiers } from "../lib/cities";
import { closeups } from "../lib/closeups";
import { stateMap } from "../lib/data";
import CityMarks from "./CityMarks.astro";
import DistrictMap from "./DistrictMap.astro";

interface Props {
  state: string;
  stateName: string;
  highlight?: string;
}

const { state, stateName, highlight } = Astro.props;
const map = stateMap(state);
const label = highlight ? `${highlight} highlighted on a map of ${stateName}` : `Map of ${stateName}'s districts`;
---

<DistrictMap state={state} viewBox={map.viewBox} paths={map.paths} label={label} highlight={highlight} idPrefix="">
  {
    closeups(state)
      .filter((c) => c.parent === undefined)
      .map(({ box: [x0, y0, x1, y1] }) => <rect class="closeup-box" x={x0} y={y0} width={x1 - x0} height={y1 - y0} />)
  }
  <CityMarks tiers={cityTiers(state)} name="state" />
</DistrictMap>
{map.note && <p class="map-note">{map.note}</p>}

<style>
  .map-note {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
