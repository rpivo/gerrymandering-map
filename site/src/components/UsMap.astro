---
import { states } from "../lib/data";
import { CALLOUT_STATES, callouts, usMap } from "../lib/us-map";

const map = usMap();
const [, , mapWidth = 0, mapHeight = 0] = map.viewBox.split(" ").map(Number);
const boxes = callouts(map);
const viewBox = `0 0 ${mapWidth + 90} ${mapHeight}`;
const statePath = (usps: string) => `/${usps.toLowerCase()}`;
// On a phone the boxes beside the map are too small to tap, so they're cut off and the small
// states get buttons below instead. Widening the drawing by this much pushes the boxes out of view.
const cropWidth = `${((mapWidth + 90) / mapWidth) * 100}%`;
---

<nav class="us-map" aria-label="States">
  <h2>Go to a state</h2>
  <div class="frame">
  <svg viewBox={viewBox} style={`--crop-width: ${cropWidth}`}>
    {
      states.map((s) => {
        const [x, y] = map.labels[s.state] ?? [0, 0];
        return (
          <a href={statePath(s.state)} aria-label={s.name}>
            <title>{s.name}</title>
            <path d={map.paths[s.state] ?? ""} fill-rule="evenodd" />
            {!CALLOUT_STATES.includes(s.state) && (
              <text x={x} y={y}>
                {s.state}
              </text>
            )}
          </a>
        );
      })
    }
    {
      boxes.map((b) => (
        <a href={statePath(b.state)} class="callout" tabindex="-1" aria-hidden="true">
          <line x1={b.from[0]} y1={b.from[1]} x2={b.x} y2={b.y} />
          <rect x={b.x} y={b.y - 13} width="64" height="26" rx="4" />
          <text x={b.x + 32} y={b.y}>
            {b.state}
          </text>
        </a>
      ))
    }
  </svg>
  </div>
  <ul class="small-states" aria-hidden="true">
    {
      boxes.map((b) => (
        <li>
          <a href={statePath(b.state)} tabindex="-1">
            {b.state}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .us-map {
    margin: 1.5rem 0;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 44rem;
  }

  path,
  rect {
    fill: var(--shape-muted);
    stroke: var(--bg);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  text {
    fill: var(--text);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .small-states {
    display: none;
  }

  /* The map shrinks to a third of its size on a phone, so labels need bigger map units there. */
  @media (max-width: 40rem) {
    text {
      font-size: 22px;
    }

    .frame {
      overflow: hidden;
    }

    svg {
      width: var(--crop-width);
      max-width: none;
    }

    .callout {
      display: none;
    }

    /* 44 pixels square at least: the size a fingertip needs. */
    .small-states {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
      margin: 0.75rem 0 0;
      padding: 0;
      list-style: none;
    }

    .small-states a {
      display: grid;
      place-items: center;
      min-height: 2.75rem;
      border-radius: 6px;
      background: var(--shape-muted);
      color: var(--text);
      font-weight: 600;
      text-decoration: none;
    }

    .small-states a:hover {
      background: var(--accent);
      color: var(--bg);
    }
  }

  line {
    stroke: var(--text-muted);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  a:hover path,
  a:focus-visible path,
  a:hover rect {
    fill: var(--accent);
  }

  a:hover text,
  a:focus-visible text {
    fill: var(--bg);
  }

  a:focus-visible path {
    stroke: var(--text);
    stroke-width: 2;
  }
</style>
